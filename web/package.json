{
  "name": "image-scraper-pro-website",
  "version": "1.0.0",
  "description": "Website for the Image Scraper Pro browser extension (Next.js, static export).",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/security-headers.mjs",
    "typecheck": "node scripts/prepare-assets.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
