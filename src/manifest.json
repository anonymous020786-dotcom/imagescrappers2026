{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Image Scraper",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Open the Image Scraper popup"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open the full Image Scraper dashboard for this tab"
    },
    "quick-download": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Download all images on this page with your default filters"
    },
    "scrape-all-tabs": {
      "description": "Scrape images from every tab in the current window"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
